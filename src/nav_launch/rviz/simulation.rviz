Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /RobotModel1
        - /TF1
        - /PointCloud21
        - /PointCloud21/Topic1
        - /Image1
        - /Map1
        - /LaserScan1
        - /LaserScan1/Topic1
        - /Path1
        - /Path1/Topic1
        - /Map2
        - /MarkerArray1
        - /Marker1
        - /Polygon1
      Splitter Ratio: 0.5
    Tree Height: 966
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: LaserScan
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: odom
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: false
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        ANKLE_L:
          Value: true
        ANKLE_R:
          Value: true
        All Enabled: true
        BASE_LINK:
          Value: true
        ELBOW_L:
          Value: true
        ELBOW_R:
          Value: true
        FEMUR_L:
          Value: true
        FEMUR_R:
          Value: true
        FOOT_L:
          Value: true
        FOOT_R:
          Value: true
        FOREARM_L:
          Value: true
        FOREARM_R:
          Value: true
        HEAD:
          Value: true
        HIP_ABAD_L:
          Value: true
        HIP_ABAD_R:
          Value: true
        HIP_L:
          Value: true
        HIP_R:
          Value: true
        LOWERSHOULDER_L:
          Value: true
        LOWERSHOULDER_R:
          Value: true
        LOWERWRIST_L:
          Value: true
        LOWERWRIST_R:
          Value: true
        NECK:
          Value: true
        TIBIA_L:
          Value: true
        TIBIA_R:
          Value: true
        UPPERARM_L:
          Value: true
        UPPERARM_R:
          Value: true
        UPPERSHOULDER_L:
          Value: true
        UPPERSHOULDER_R:
          Value: true
        UPPERWRIST_L:
          Value: true
        UPPERWRIST_R:
          Value: true
        chest_camera_link:
          Value: true
        chest_depth_camera_link:
          Value: true
        chest_depth_camera_optical_link:
          Value: true
        map:
          Value: true
        odom:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        map:
          odom:
            BASE_LINK:
              HIP_L:
                HIP_ABAD_L:
                  FEMUR_L:
                    TIBIA_L:
                      ANKLE_L:
                        FOOT_L:
                          {}
              HIP_R:
                HIP_ABAD_R:
                  FEMUR_R:
                    TIBIA_R:
                      ANKLE_R:
                        FOOT_R:
                          {}
              NECK:
                HEAD:
                  {}
              UPPERSHOULDER_L:
                LOWERSHOULDER_L:
                  UPPERARM_L:
                    ELBOW_L:
                      FOREARM_L:
                        UPPERWRIST_L:
