# ============================================================
# THEMIS Nav2 导航参数配置
# 使用方式:
#   ros2 launch nav_launch themis_navigation.launch.py
#   ros2 launch nav_launch themis_navigation.launch.py \
#       params_file:=/path/to/custom_params.yaml
# ============================================================

# ----------------- 生命周期管理器 -----------------
lifecycle_manager_navigation:
  ros__parameters:
    use_sim_time: true
    autostart: true
    node_names: ['controller_server', 'planner_server', 'behavior_server',
                 'bt_navigator', 'waypoint_follower', 'local_costmap',
                 'global_costmap']

# ----------------- 行为树导航器 -----------------
bt_navigator:
  ros__parameters:
    use_sim_time: true
    global_frame: map
    robot_base_frame: BASE_LINK
    odom_topic: /odom
    bt_loop_duration: 10
    default_server_timeout: 20
    default_nav_to_pose_bt_xml: "/home/wzz2002/THEMIS/THEMIS/nav_ws/src/nav2_custom_plugins/behavior_trees/navigate_to_pose_w_diag_recovery.xml"
    default_nav_through_poses_bt_xml: "/home/wzz2002/THEMIS/THEMIS/nav_ws/src/nav2_custom_plugins/behavior_trees/navigate_to_pose_w_diag_recovery.xml"
    navigators: ['navigate_to_pose', 'navigate_through_poses']
    navigate_to_pose:
      plugin: "nav2_bt_navigator::NavigateToPoseNavigator"
      goal_reached_tol: 0.25
      goal_reached_yaw_tol: 0.50
    navigate_through_poses:
      plugin: "nav2_bt_navigator::NavigateThroughPosesNavigator"

# ----------------- 规划器 (全局路径规划) -----------------
# NavfnPlanner: 基于 NavFn 势场算法的全局规划器 (ROS1 经典算法)。
# 使用 Dijkstra (默认) / A* 在 costmap 上计算势场，
# 通过梯度下降回溯提取路径，再经 SE2 轨迹优化进行
# 平滑和避障优化，每个 waypoint 带有推荐朝向 (yaw)。
planner_server:
  ros__parameters:
    expected_planner_frequency: 10.0
    use_sim_time: true
    planner_plugins: ["GridBased"]
    GridBased:
      plugin: "nav2_navfn_planner/NavfnPlanner"

      # ════════════════════════════════════════════════════════════════
      # 核心规划参数
      # ════════════════════════════════════════════════════════════════
      tolerance: 0.5                    # 目标被阻挡时的松弛容差 (m)
      use_astar: false                  # false=Dijkstra (最优), true=A* (更快)
      allow_unknown: true               # 允许穿越未知区域
      use_final_approach_orientation: false

      # ════════════════════════════════════════════════════════════════
      # SE2 轨迹优化 (Navfn 原始路径 → 平滑 + 避障优化)
      # ════════════════════════════════════════════════════════════════
      enable_se2_optimization: true     # 启用 SE2 优化 (提供推荐朝向)
      se2_resample_resolution: 0.10     # 重采样间距 (m)
      se2_max_optimization_points: 100  # 最大优化点数
      se2_iterations: 35                # 梯度下降迭代次数
      se2_learning_rate: 0.02           # 学习率 (带衰减)
      se2_fd_eps: 0.02                  # 有限差分扰动 (m)
      se2_max_step: 0.20                # 相邻点最大步长 (m)
      se2_max_yaw_delta: 0.45           # 相邻点最大朝向变化 (rad, ~26°)

      # ════════════════════════════════════════════════════════════════
      # 机器人尺寸 (x前后=0.40m, y左右=0.60m, 前面=长边)
      # ════════════════════════════════════════════════════════════════
      robot_length: 0.40                # 前后 x (m)
      robot_width: 0.60                 # 左右 y / 前面 (m)
      robot_safe_distance: 0.10         # 安全距离裕量 (m)

      # ════════════════════════════════════════════════════════════════
      # SE2 优化代价权重
      # ════════════════════════════════════════════════════════════════
      se2_w_obs: 300.0                   # 障碍物代价权重
      se2_w_ref: 0.3                    # 参考路径偏差权重
      se2_w_smooth: 8.0                 # 路径平滑权重
      se2_w_yaw_smooth: 1.0             # 朝向平滑权重
      se2_w_align: 0.4                  # 朝向对齐权重
      se2_w_tangent: 3.0                # 切向偏好权重
      se2_w_step: 2.0                   # 步长约束权重

      # ════════════════════════════════════════════════════════════════
      # SE2 后处理平滑
      # ════════════════════════════════════════════════════════════════
      se2_post_smooth_passes: 2         # 后处理平滑轮数
      se2_post_smooth_alpha: 0.35       # 平滑强度 (0~1)

# ----------------- 控制器 (局部路径规划) -----------------
controller_server:
  ros__parameters:
    use_sim_time: true
    controller_frequency: 10.0
    min_x_velocity_threshold: 0.001
    min_y_velocity_threshold: 0.001
    min_theta_velocity_threshold: 0.001
    failure_tolerance: 999.0           # 禁用卡死判定：不因控制器失败触发恢复
    progress_checker_plugin: "progress_checker"
    goal_checker_plugins: ["general_goal_checker"]
    controller_plugins: ["FollowPath"]

    progress_checker:
      plugin: "nav2_controller::SimpleProgressChecker"
      required_movement_radius: 0.0    # 禁用移动进度检查
      movement_time_allowance: 999999.0 # 禁用超时判定
    general_goal_checker:
      stateful: True
      plugin: "nav2_controller::SimpleGoalChecker"
      xy_goal_tolerance: 0.20          # 20cm, MPPI 移动容差
      yaw_goal_tolerance: 0.087       # 5°

    FollowPath:
      plugin: "nav2_custom_plugins/MPPIGPUController"

      # ╔══════════════════════════════════════════════════════════════════╗
      # ║       MPPI GPU 控制器 — 移植自 nav2_mppi_controller              ║
      # ╠══════════════════════════════════════════════════════════════════╣
      # ║                                                                  ║
      # ║  total_cost = obstacle_weight  × ObstaclesCritic                ║
      # ║             + tracking_weight  × (PathAlign + PathAngle         ║
      # ║                                  + GoalAngle)                   ║
      # ║             + progress_weight  × (PreferForward + GoalCritic)   ║
      # ║                                                                  ║
      # ║  参考: nav2 MPPI critics (Williams 2017 MPPI)                    ║
      # ║    obstacle_weight ↑ → 更保守, 远离障碍                          ║
      # ║    tracking_weight ↑ → 更贴路径, 朝向对齐                        ║
      # ║    progress_weight ↑ → 更快/更高效到达目标                        ║
      # ╚══════════════════════════════════════════════════════════════════╝

      # ════════════════════════════════════════════════════════════════
      # 三组件代价权重
      # ════════════════════════════════════════════════════════════════
      obstacle_weight: 10.0        # ObstaclesCritic: 碰撞检测 (norm^4)
      tracking_weight: 30.0        # PathAlignCritic + PathAngleCritic + GoalAngleCritic
      progress_weight: 30.0         # PreferForwardCritic + GoalCritic (提高→增强转弯跟随)

      # ════════════════════════════════════════════════════════════════
      # 预测时空 (dt × horizon × max_v = 有效预测距离)
      # ════════════════════════════════════════════════════════════════
      #   dt×H×max_v = 0.1×12×0.4 = 0.48m, 前瞻点 0.4m
      num_samples: 3000
      prediction_horizon: 12
      dt: 0.1
      max_v: 0.40
      min_v: -0.10
      max_vy: 0.20
      max_w: 0.60

      # ════════════════════════════════════════════════════════════════
      # 噪声 (采样侧)
      # ════════════════════════════════════════════════════════════════
      action_std_v: 0.5           # vx 噪声 (平衡: 够覆盖 max_v 又不大量后退)
      action_std_vy: 0.5
      action_std_w: 0.4
      nln_ratio: 0.35             # 对数正态占比
      noise_decay_rate: 0.55      # 时间衰减
      noise_scale_floor_vx: 0.35   # vx 探索下限
      noise_scale_floor_vy: 0.30
      noise_scale_floor_w: 0.30
      cross_track_noise_scale: 1.5 # 横向噪声缩放

      # ════════════════════════════════════════════════════════════════
      # 路径引导 (采样侧: 噪声偏置方向, 不影响代价)
      # ════════════════════════════════════════════════════════════════
      #   vx/vy = (1-γ)×(base+noise) + γ×(path_dir×speed)
      #   γ=0: 纯采样, γ=1: 纯路径锚定
      guidance_weight: 0.0       # 引导强度: 降低 vx 偏置, 给 vy 更多自由度

      # ════════════════════════════════════════════════════════════════
      # 转弯横向增强 (采样侧: 急弯时自动放大横向运动)
      # ════════════════════════════════════════════════════════════════
      turn_lateral_boost: 2.0      # 转弯增强倍数 (0=关闭)
      lateral_guidance_scale: 0.7  # 横向 guidance 基值缩放

      # ════════════════════════════════════════════════════════════════
      # MPPI 温度
      # ════════════════════════════════════════════════════════════════
      #   weight = exp(-cost / lambda). lambda↑ → 代价差异稀释
      lambda: 1.0

      # ════════════════════════════════════════════════════════════════
      # 碰撞检测
      # ════════════════════════════════════════════════════════════════
      footprint_front: 0.17
      footprint_back: 0.17
      footprint_left: 0.28
      footprint_right: 0.28
      footprint_sample_spacing: 0.04
      rear_obstacle_cost: 0.0       # 后方隐形障碍地板 (已移除)

      # ════════════════════════════════════════════════════════════════
      # 前瞻点决策
      # ════════════════════════════════════════════════════════════════
      min_lookahead_dist: 0.4       # 前瞻距离 (m)
      lookahead_kp: 1.0             # 前瞻减速 (1.0=不减速)

      # ════════════════════════════════════════════════════════════════
      # 终端行为 (与 general_goal_checker 协调)
      # ════════════════════════════════════════════════════════════════
      #   terminal_angle_dist (0.10m): 终端区域代价清零, MPPI 自然对齐
      #   terminal_angle_tolerance (4°) < yaw_goal_tolerance (5°)
      terminal_angle_dist: 0.08
      terminal_angle_kp: 1.5
      terminal_angle_tolerance: 0.07

      # ════════════════════════════════════════════════════════════════
      # 分层规划
      # ════════════════════════════════════════════════════════════════
      #   30% 轨迹直接预测到终点 (终端引导)
      #   70% 轨迹跟随局部前瞻点 (路径跟踪, 避障)
      global_trajectory_ratio: 0.3
      global_horizon: 50            # dt×50×max_v = 0.3×50×0.4 = 6.0m 覆盖

      # ════════════════════════════════════════════════════════════════
      # 独立功能开关
      # ════════════════════════════════════════════════════════════════
      pure_rotation_ratio: 0.10     # 纯旋转轨迹占比
      pure_rotation_steps: 2
      enable_lateral_bias: false    # 横向偏好分析
      enable_heading_speed_limit: true
      heading_misalign_threshold: 1.047  # 速度方向偏差阈值 (rad), 60°
      enable_narrow_passage: false   # 窄道侧身脱离 (暂时关闭)
      enable_ema: false
      ema_alpha: 0.1

      # ╔══════════════════════════════════════════════════════════════════╗
      # ║                    调参速查 (3 权重优先)                         ║
      # ╠══════════════════════════════════════════════════════════════════╣
      # ║ 场景                        调法                                 ║
      # ║ ────                        ────                                 ║
      # ║ 离障碍物太近/擦边           obstacle_weight ↑                    ║
      # ║ 不敢靠近障碍物(过度保守)    obstacle_weight ↓                    ║
      # ║ 朝向不对/终点对不准         tracking_weight ↑                    ║
      # ║ 转弯后摆动(过度对齐)        tracking_weight ↓                    ║
      # ║ 跑得太慢/犹豫               progress_weight ↑                    ║
      # ║ 跑得太快/冲过头             progress_weight ↓                    ║
      # ║ 窄通道卡住                  noise_scale_floor_vy ↑               ║
      # ║ 轨迹末端蛇形                noise_decay_rate ↑, enable_ema=true  ║
      # ║ 局部极小出不来              nln_ratio ↑                          ║
      # ║                             global_trajectory_ratio ↑            ║
      # ╚══════════════════════════════════════════════════════════════════╝

# ----------------- 行为/恢复服务器 -----------------
behavior_server:
  ros__parameters:
    costmap_topic: local_costmap/costmap_raw
    footprint_topic: local_costmap/published_footprint
    cycle_frequency: 10.0
    behavior_plugins: ["escape", "backup", "drive_on_heading"]
    escape:
      plugin: "nav2_custom_plugins/EscapeObstacle"
      escape_distance: 0.10        # 逃逸移动距离 (m)
      scan_radius: 0.10            # 360° 障碍物扫描半径 (m)
      scan_directions: 24          # 扫描方向数 (越多越精细)
      scan_depth: 4                # 每个径向采样层数
      scan_lateral_span: 0.12      # 横向采样宽度 (m)
      escape_speed: 0.15           # 逃逸速度 (m/s)
      obstacle_threshold: 128.0      # 障碍代价阈值, >此值视为障碍
      prefer_back_ratio: 0.5       # 后退偏好 [0,1]: 0=纯安全方向, 1=偏向后退
      check_ahead_dist: 0.15       # 移动中前方安全检测距离 (m)
    backup:
      plugin: "nav2_behaviors/BackUp"
    drive_on_heading:
      plugin: "nav2_custom_plugins/EscapeObstacle"
      escape_distance: 0.10        # 逃逸移动距离 (m)
      scan_radius: 0.10            # 360° 障碍物扫描半径 (m)
      scan_directions: 24
      scan_depth: 4
      scan_lateral_span: 0.12
      escape_speed: 0.15
      obstacle_threshold: 128.0
      prefer_back_ratio: 0.0       # heading模式: 不偏好后退, 纯选最安全方向
      check_ahead_dist: 0.15
    global_frame: odom
    robot_base_frame: BASE_LINK
    transform_tolerance: 0.1
    use_sim_time: true
    simulate_ahead_time: 2.0
    max_rotational_vel: 1.0
    min_rotational_vel: 0.4
    rotational_acc_lim: 3.2

# ----------------- 全局代价地图 -----------------
global_costmap:
  global_costmap:
    ros__parameters:
      update_frequency: 1.0         # 降低以避免反复重规划打断窄道计时
      publish_frequency: 1.0
      global_frame: map
      robot_base_frame: BASE_LINK
      use_sim_time: true
      footprint: "[[0.20, 0.30], [0.20, -0.30], [-0.20, -0.30], [-0.20, 0.30]]"
      resolution: 0.05
      track_unknown_space: true
      plugins: ["static_layer", "obstacle_layer", "inflation_layer"]
      static_layer:
        plugin: "nav2_costmap_2d::StaticLayer"
        map_subscribe_transient_local: True
        map_topic: /rtabmap/map
      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        enabled: True
        observation_sources: pointcloud_sensor
        pointcloud_sensor:
          topic: /chest_camera/points_sparse
          data_type: "PointCloud2"
          max_obstacle_height: 1.7
          min_obstacle_height: 0.1
          obstacle_max_range: 3.0
          raytrace_max_range: 3.5
          clearing: True
          marking: True
      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        cost_scaling_factor: 4.0     # 衰减更缓 → 路径远离障碍物
        inflation_radius: 0.50       # > 外接圆 0.36m, 留安全裕量

# ----------------- 局部代价地图 -----------------
local_costmap:
  local_costmap:
    ros__parameters:
      update_frequency: 10.0
      publish_frequency: 10.0
      global_frame: odom
      robot_base_frame: BASE_LINK
      use_sim_time: true
      rolling_window: true
      width: 3
      height: 3
      resolution: 0.05
      footprint: "[[0.20, 0.30], [0.20, -0.30], [-0.20, -0.30], [-0.20, 0.30]]"

      plugins: ["static_layer", "voxel_layer", "inflation_layer"]
      static_layer:
        plugin: "nav2_costmap_2d::StaticLayer"
        map_subscribe_transient_local: True
        map_topic: /rtabmap/map
      voxel_layer:
        plugin: "nav2_costmap_2d::VoxelLayer"
        enabled: True
        publish_voxel_map: True

        # --- 控制体素网格的整体高度 ---
        origin_z: 0.0
        z_resolution: 0.1        # Z轴分辨率 10cm
        z_voxels: 14             # 14层 * 0.1m = 1.4m 的总网格高度 (覆盖机器人的 1.2m 身高)

        # ★ 核心参数：决定哪些高度的障碍物会被投影到2D地图上
        max_obstacle_height: 1.7 # 忽略 1.3m 以上的障碍物，允许机器人从下方穿过

        # 未知区域处理（如果雷达扫不到上方，默认上方是安全的）
        unknown_threshold: 15
        mark_threshold: 0

        observation_sources: pointcloud_sensor
        pointcloud_sensor:
          topic: /chest_camera/points_sparse
          data_type: "PointCloud2"

          # ★ 核心参数：在数据源头过滤掉不需要关心的高空点云
          max_obstacle_height: 1.7 # 高于 1.3m 的雷达点云直接扔掉，节省 CPU 算力
          min_obstacle_height: 0.1 # 过滤掉 0.1m 以下的地面点云

          obstacle_max_range: 3.0
          raytrace_max_range: 3.5
          clearing: True
          marking: True
      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        cost_scaling_factor: 7.0    # 与全局一致, 允许擦边
        inflation_radius: 0.25

# ----------------- 航点跟随器 -----------------
waypoint_follower:
  ros__parameters:
    loop_rate: 20
    stop_on_failure: false
    waypoint_task_executor_plugin: "wait_at_waypoint"
    wait_at_waypoint:
      plugin: "nav2_waypoint_follower::WaitAtWaypoint"
      waypoint_pause_duration: 200
